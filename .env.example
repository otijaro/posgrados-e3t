
# Base de Datos
DATABASE_URL=postgresql://posgrados_user:posgrados_pass@localhost:5432/posgrados_db

# Seguridad
SECRET_KEY=cambiar-esto-en-produccion-usar-secreto-largo-y-aleatorio
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS (Frontend URLs permitidas)
ALLOWED_ORIGINS=["http://localhost:3000"]

# Email (recuperación de contraseña — Gmail personal con contraseña de aplicación:
# https://myaccount.google.com/apppasswords — no funciona con cuentas de Workspace
# administradas por la universidad si el admin desactivó esa opción)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# URL pública del frontend, se usa para construir el enlace del correo
FRONTEND_URL=http://localhost:3000

# Login con Microsoft (OAuth2 / correo institucional @uis.edu.co)
# Registrar la app en https://entra.microsoft.com → App registrations → New registration
# Redirect URI a registrar: http://localhost:3000/api/auth/microsoft/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=

# Storage
STORAGE_BASE_URL=https://drive.google.com